ype": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "allowed_attempts": 2, "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!"}}]}, {"questions": [{"_data": [{"contents": [{"type": "pdf", "content": "engenn8le15ob07re7pdf01.pdf"}], "type": "question"}], "id": 0, "responses": [{"correct": 1, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}]}], "stimuli_ids": [], "template_override": 1, "type": "DWS", "id": 11, "_data": [{"contents": [{"type": "text", "content": " \nWrite a thank you letter.\n"}, {"type": "text", "content": " "}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Take Away"}], "type": "group"}, {"type": "feedback", "content": {"incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "allowed_attempts": 2, "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!"}}, {"contents": [{"type": "text", "content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n"}], "type": "post_instructions"}, {"contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}], "type": "learning_skills"}]}], "type": "scholar", "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}], "id": 0, "stimuli": [{"contents": [{}], "type": "welcome", "_data": [], "id": 0, "template_override": 1}, {"contents": [{"type": "slideshow", "value": {"audiosrc": "engenn8le15ob07re2aud01", "images": [{"time": "0", "text": "", "id": 0, "image": "engenn8le15ob07re2img01.jpg"}, {"time": "100", "text": "Dear Dr. Richardson,<br/><br/>\n<p>I am writing to express my deepest gratitude for what you have done for our son, Brad.</p>When Brad lost his leg in that horrific car accident last year, he was devastated. In fact, he became very depressed and withdrawn. Of course, we worried that this would be irrevocable. After all, Brad had always been athletic and loved sports. So, he was certain that his life, as he knew it, would be over.", "id": 1, "image": "engenn8le15ob07re2img01.jpg"}, {"time": "27000", "text": "Then, your office contacted him and gave him hope. They told him about the incredible advances in prosthetic limbs. They said he could be fitted with a robotic prosthesis and that could be controlled with his mind. According to him, this opportunity changed his life forever.", "id": 2, "image": "engenn8le15ob07re2img03.jpg"}, {"time": "45000", "text": "<p>Brad worked tirelessly with your team so his new leg could function like his real leg. Thanks to your innovative work in bionics, Brad can do almost everything he used to do. For this reason, he now views his life in a different light. In fact, he has decided to go into medicine so that he can help others as you have helped him.</p>\n<p>Of course, I cannot thank you or praise you enough. We have our son back. </p>\n<p>All the best to you and good luck in your research.</p><br/>\nDonna Patrick", "id": 3, "image": "engenn8le15ob07re2img01.jpg"}], "coverimg": "engenn8le15ob07re2img01.jpg"}}], "id": 1, "template_override": 1, "type": "audio", "title": "", "_data": []}]}]}